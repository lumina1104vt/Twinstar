// The twin-star order and plan screens (client/ui/OrderUI, PlanUI): black panel, violet accents,
// Minecraft's pixel font (PixelLabel). Layout (sizes, rows, gaps) is set in code; this sheet only
// gives the look.

// ── surfaces ────────────────────────────────────────────────────────────────
.plan_root {
  background: sprite(twinstar:textures/gui/plan_ui.png);
}

.order_root {
  background: sprite(twinstar:textures/gui/order_ui.png);
}

// the item's icon frame on the order screen
.slot {
  background: sprite(twinstar:textures/gui/inset_track.png, 0, 0, 16, 16, 2, 2, 2, 2);
}

.amount_field {
  background: rect(#040408, 0, 1, #4e4474);
}

// the cards: nine-slice so the violet corner brackets stay in the corners at any size
.card {
  background: sprite(twinstar:textures/gui/inset.png, 0, 0, 16, 16, 5, 5, 5, 5);
}

.card_missing {
  background: sprite(twinstar:textures/gui/inset_missing.png, 0, 0, 16, 16, 5, 5, 5, 5);
}

.row_missing {
  background: rect(#30141c);
}

// ── text ────────────────────────────────────────────────────────────────────
text, label {
  text-shadow: false;
  text-color: #dedeea;
  font: minecraft:default;
}

.title {
  text-color: #d6ccff;
}

.small {
  font-size: 7;
}

.dim {
  text-color: #8c8ca2;
}

.bad {
  text-color: #ff7474;
}

.good {
  text-color: #78e296;
}

// ── buttons ─────────────────────────────────────────────────────────────────
button:host {
  base-background: rect(#1e1c2c, 0, 1, #4e4474);
  hover-background: rect(#2c2642, 0, 1, #a082f0);
  pressed-background: rect(#16141f, 0, 1, #a082f0);
  padding-all: 3;
}

button:host .__button_text__ {
  text-color: #dedeea;
  text-shadow: false;
  font: minecraft:default;
}

button:disabled:host {
  base-background: rect(#101016, 0, 1, #282634);
}

button:disabled:host .__button_text__ {
  text-color: #64647a;
}

// ── scrolling (the tree and the missing list) ───────────────────────────────
scroller-view {
  scroller-view-margin: 0;
}

.__scroller_view_view-port__ {
  background: empty;
  padding-all: 0;
}

.__scroller_view_vertical-scroller__ {
  width: 5;
  margin-left: 1;
}

scroller-vertical:host {
  width: 5;
}

.__scroller_scroll_container__ {
  background: rect(#040406);
  padding-all: 0;
}

scroller-vertical .__scroller_scroll_bar__ {
  base-background: rect(#463e68, 0, 1, #7864b4);
  hover-background: rect(#5a5084, 0, 1, #a082f0);
  pressed-background: rect(#a082f0);
}

.__scroller_head_button__, .__scroller_tail_button__ {
  display: none;
}
